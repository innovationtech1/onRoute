rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // Administrador de OnRoute (Hector): la cuenta guardada en meta/owner.
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/meta/owner)
        && get(/databases/$(database)/documents/meta/owner).data.uid == request.auth.uid;
    }

    function rest(rid) { return get(/databases/$(database)/documents/restaurants/$(rid)).data; }
    function isOwnerOf(rid) {
      return signedIn()
        && exists(/databases/$(database)/documents/restaurants/$(rid))
        && rest(rid).ownerUid == request.auth.uid;
    }

    // Datos del perfil que el dueño puede cambiar (nunca status ni ownerUid).
    function profileKeys() {
      return ['name','kind','cuisine','description','phone','address','lat','lng','logoUrl',
              'paused','menuNote','variant','loc','hours','promos','loyalty','delivery','updatedAt'];
    }
    function validProfile(d) {
      return d.name is string && d.name.size() >= 2 && d.name.size() <= 60
        && d.kind in ['truck','restaurant']
        && (!('description' in d) || (d.description is string && d.description.size() <= 300))
        && (!('cuisine' in d) || (d.cuisine is string && d.cuisine.size() <= 60))
        && (!('paused' in d) || d.paused is bool)
        && (!('hours' in d) || (d.hours is map && d.hours.days is list && d.hours.days.size() == 7))
        && (!('logoUrl' in d) || (d.logoUrl is string && d.logoUrl.size() <= 60000))
        // Entrega a domicilio con repartidores de OnRoute (radio en millas, máximo 8).
        && (!('delivery' in d) || (d.delivery is map && d.delivery.keys().hasOnly(['on','radius'])
            && d.delivery.on is bool && d.delivery.radius is number && d.delivery.radius > 0 && d.delivery.radius <= 8))
        // Promociones (máximo 10) y tarjeta de cliente frecuente.
        && (!('promos' in d) || (d.promos is list && d.promos.size() <= 10))
        && (!('loyalty' in d) || (d.loyalty is map && d.loyalty.keys().hasOnly(['on','every','reward'])
            && d.loyalty.on is bool && d.loyalty.every is int && d.loyalty.every >= 2 && d.loyalty.every <= 20
            && d.loyalty.reward is string && d.loyalty.reward.size() <= 60));
    }

    // ---------- Administración ----------
    match /meta/owner {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ---------- Usuarios (clientes y negocios) ----------
    // users/{uid}: cada quien lee y edita su perfil; el administrador ve a todos.
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['role','name','email','phone','favorites','createdAt'])
        && request.resource.data.role in ['customer','business','driver']
        && request.resource.data.name is string && request.resource.data.name.size() <= 60;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','name','phone','favorites'])
        && request.resource.data.role in ['customer','business','driver']
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.favorites is list && request.resource.data.favorites.size() <= 50;
      allow delete: if isAdmin();

      // Historial del cliente: una copia de cada pedido que hizo con su cuenta.
      match /orders/{oid} {
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['rid','rname','num','total','items','cart','pay','createdAt'])
          && exists(/databases/$(database)/documents/restaurants/$(request.resource.data.rid)/orders/$(oid));
        allow delete: if signedIn() && request.auth.uid == uid;
        allow update: if false;
      }
    }

    // ---------- Repartidores ----------
    // drivers/{uid}: el repartidor llena su registro y queda "pending" hasta que el admin lo aprueba.
    // El estado y la cuenta de Stripe solo los cambian el admin o el servidor de pagos.
    function driverKeys() {
      return ['name','phone','email','vehicle','licenseExpires','attest','online','loc','payout','updatedAt'];
    }
    function validDriver(d) {
      return d.name is string && d.name.size() >= 2 && d.name.size() <= 60
        && d.phone is string && d.phone.size() >= 7 && d.phone.size() <= 30
        && d.vehicle is map && d.vehicle.keys().hasOnly(['make','model','year','color','plate'])
        && d.vehicle.plate is string && d.vehicle.plate.size() >= 2 && d.vehicle.plate.size() <= 12
        && d.licenseExpires is string && d.licenseExpires.size() == 10
        && d.attest is map && d.attest.license == true && d.attest.registration == true
        && d.attest.insurance == true && d.attest.terms == true
        && (!('online' in d) || d.online is bool)
        // Cómo cobra: depósito con Stripe o a mano por Cash App, Zelle o Venmo.
        && (!('payout' in d) || (d.payout is map && d.payout.keys().hasOnly(['method','app','handle'])
            && d.payout.method in ['stripe','manual'] && d.payout.app in ['cashapp','zelle','venmo']
            && d.payout.handle is string && d.payout.handle.size() >= 1 && d.payout.handle.size() <= 60));
    }
    match /drivers/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(driverKeys().concat(['status','createdAt']))
        && request.resource.data.status == 'pending'
        && validDriver(request.resource.data);
      allow update: if (signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(driverKeys())
          && validDriver(request.resource.data))
        || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['pending','active','suspended']);
      allow delete: if isAdmin();

      // Foto de la licencia: privada, solo la ven el repartidor y el administrador.
      match /docs/{doc} {
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
        allow create, update: if signedIn() && request.auth.uid == uid
          && doc == 'license'
          && request.resource.data.keys().hasOnly(['data','createdAt'])
          && request.resource.data.data is string
          && request.resource.data.data.size() < 400000;
        allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
      }
    }

    // ---------- Entregas a domicilio ----------
    // deliveries/{id}: las crea y cambia el servidor de pagos (aceptar, recoger, entregar, pagar).
    // Los repartidores activos ven las que buscan repartidor; cada repartidor ve las suyas.
    function isActiveDriver() {
      return signedIn()
        && exists(/databases/$(database)/documents/drivers/$(request.auth.uid))
        && get(/databases/$(database)/documents/drivers/$(request.auth.uid)).data.status == 'active';
    }
    match /deliveries/{id} {
      allow get: if true;
      allow list: if isAdmin()
        || (resource.data.status == 'searching' && isActiveDriver())
        || (signedIn() && resource.data.driverUid == request.auth.uid);
      // El repartidor asignado comparte su ubicación; el negocio avisa cómo va la cocina.
      allow update: if (signedIn() && resource.data.driverUid == request.auth.uid
          && resource.data.status in ['assigned','picked']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['driverLoc']))
        || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['payout','payoutAt'])
          && request.resource.data.payout == 'paid_manual')
        || (isOwnerOf(resource.data.rid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['kitchen'])
          && request.resource.data.kitchen in ['new','prep','ready','done']);
      allow create, delete: if false;

      // Dirección exacta y teléfono del cliente: solo el repartidor asignado, el negocio y el administrador.
      match /private/{doc} {
        allow get: if signedIn() && (
          get(/databases/$(database)/documents/deliveries/$(id)).data.driverUid == request.auth.uid
          || isOwnerOf(get(/databases/$(database)/documents/deliveries/$(id)).data.rid)
          || isAdmin());
        allow list, write: if false;
      }
    }

    // ---------- Negocios ----------
    // restaurants/{rid}: rid es el enlace del negocio (ej. "tortas-tortuga").
    match /restaurants/{rid} {
      allow get, list: if resource.data.status == 'active'
        || (signedIn() && resource.data.ownerUid == request.auth.uid)
        || isAdmin();
      // Cualquiera con cuenta puede registrar su negocio; queda "pending" hasta que el admin lo aprueba.
      allow create: if signedIn()
        && rid.matches('^[a-z0-9][a-z0-9-]{1,38}[a-z0-9]$')
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(profileKeys().concat(['ownerUid','status','createdAt']))
        && validProfile(request.resource.data);
      allow update: if (signedIn() && resource.data.ownerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(profileKeys())
          && validProfile(request.resource.data))
        || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['pending','active','suspended']);
      allow delete: if isAdmin();

      // Menú del negocio: todos lo leen, solo el dueño lo cambia.
      match /menu/{doc} {
        allow read: if true;
        allow write: if isOwnerOf(rid)
          && request.resource.data.keys().hasOnly(['items','extras','updatedAt'])
          && request.resource.data.items is list
          && request.resource.data.items.size() <= 100;
      }

      // Fotos de los platillos (plan gratuito): imágenes comprimidas, máximo ~300 KB cada una.
      match /photos/{pid} {
        allow read: if true;
        allow create, update: if isOwnerOf(rid)
          && request.resource.data.keys().hasOnly(['data','createdAt'])
          && request.resource.data.data is string
          && request.resource.data.data.size() < 300000;
        allow delete: if isOwnerOf(rid);
      }

      // Pedidos: el cliente crea el suyo (pago al recoger) y lo sigue por su número;
      // solo el dueño ve la lista y cambia el estado. Los pedidos con tarjeta los crea el servidor.
      match /orders/{oid} {
        allow get: if true;
        allow list: if isOwnerOf(rid) || isAdmin();
        allow create: if rest(rid).status == 'active'
          && !(('paused' in rest(rid)) && rest(rid).paused == true)
          && request.resource.data.keys().hasOnly(['num','who','items','total','status','pickup','createdAt','pay','uid','note','subtotal','promo','reward'])
          // Promoción: el descuento nunca es mayor que el subtotal y el total es subtotal menos descuento.
          && (!('promo' in request.resource.data) || (request.resource.data.promo is map
              && request.resource.data.promo.keys().hasOnly(['title','code','off'])
              && request.resource.data.promo.off is number && request.resource.data.promo.off > 0
              && request.resource.data.subtotal is number && request.resource.data.subtotal < 1000
              && request.resource.data.promo.off <= request.resource.data.subtotal
              && request.resource.data.total >= request.resource.data.subtotal - request.resource.data.promo.off - 0.01))
          && (!('subtotal' in request.resource.data) || 'promo' in request.resource.data)
          // Premio de cliente frecuente: solo en pedidos con cuenta (el negocio lo verifica en su pantalla).
          && (!('reward' in request.resource.data) || (request.resource.data.reward is string && request.resource.data.reward.size() <= 60
              && 'uid' in request.resource.data))
          && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 200))
          && (!('uid' in request.resource.data) || (signedIn() && request.resource.data.uid == request.auth.uid))
          && request.resource.data.status == 'new'
          && request.resource.data.pay == 'cash'
          && request.resource.data.who is string && request.resource.data.who.size() >= 1 && request.resource.data.who.size() <= 40
          && request.resource.data.items is list && request.resource.data.items.size() <= 30
          && request.resource.data.total is number && request.resource.data.total < 1000;
        allow update: if isOwnerOf(rid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['new','prep','ready','done'];
        allow delete: if isOwnerOf(rid);

        // Mensajes del pedido. Canales: cb = cliente↔negocio, db = repartidor↔negocio, dc = repartidor↔cliente.
        // El cliente entra con el número interno del pedido (igual que para seguirlo); los canales con el
        // repartidor solo existen en entregas a domicilio. Se puede escribir durante 6 horas después del pedido.
        match /msgs/{mid} {
          function ord() { return get(/databases/$(database)/documents/restaurants/$(rid)/orders/$(oid)).data; }
          function dlvPath() { return /databases/$(database)/documents/deliveries/$(oid); }
          function isDrv() { return signedIn() && exists(dlvPath()) && get(dlvPath()).data.driverUid == request.auth.uid; }
          function picked() { return exists(dlvPath()) && get(dlvPath()).data.status == 'picked'; }
          allow read: if resource.data.ch in ['cb','dc']
            || (resource.data.ch == 'db' && (isOwnerOf(rid) || isDrv() || isAdmin()));
          allow create: if request.resource.data.keys().hasOnly(['ch','from','name','text','at'])
            && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 500
            && request.resource.data.name is string && request.resource.data.name.size() <= 40
            && request.resource.data.at is number
            && ord().createdAt > request.time.toMillis() - 21600000
            && ((request.resource.data.from == 'customer' && (request.resource.data.ch == 'cb' || (request.resource.data.ch == 'dc' && picked())))
              || (request.resource.data.from == 'business' && isOwnerOf(rid) && request.resource.data.ch in ['cb','db'])
              || (request.resource.data.from == 'driver' && isDrv() && (request.resource.data.ch == 'db' || (request.resource.data.ch == 'dc' && picked()))));
          allow update, delete: if false;
        }
      }
    }

    // ---------- Datos de la versión anterior (solo Tortas Tortuga) ----------
    // Se conservan para poder importarlos al nuevo formato. El admin los lee; nadie más los cambia.
    match /orders/{id} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if false;
    }
    match /settings/{doc} {
      allow read: if true;
      allow write: if false;
    }
  }
}
