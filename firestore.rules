rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // Administrador de OnRoute (Hector): la cuenta guardada en meta/owner.
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/meta/owner)
        && get(/databases/$(database)/documents/meta/owner).data.uid == request.auth.uid;
    }

    function rest(rid) { return get(/databases/$(database)/documents/restaurants/$(rid)).data; }
    function isOwnerOf(rid) {
      return signedIn()
        && exists(/databases/$(database)/documents/restaurants/$(rid))
        && rest(rid).ownerUid == request.auth.uid;
    }

    // Datos del perfil que el dueño puede cambiar (nunca status ni ownerUid).
    function profileKeys() {
      return ['name','kind','cuisine','description','phone','address','lat','lng','logoUrl',
              'paused','menuNote','variant','loc','hours','updatedAt'];
    }
    function validProfile(d) {
      return d.name is string && d.name.size() >= 2 && d.name.size() <= 60
        && d.kind in ['truck','restaurant']
        && (!('description' in d) || (d.description is string && d.description.size() <= 300))
        && (!('cuisine' in d) || (d.cuisine is string && d.cuisine.size() <= 60))
        && (!('paused' in d) || d.paused is bool)
        && (!('hours' in d) || (d.hours is map && d.hours.days is list && d.hours.days.size() == 7))
        && (!('logoUrl' in d) || (d.logoUrl is string && d.logoUrl.size() <= 60000));
    }

    // ---------- Administración ----------
    match /meta/owner {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ---------- Usuarios (clientes y negocios) ----------
    // users/{uid}: cada quien lee y edita su perfil; el administrador ve a todos.
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['role','name','email','phone','favorites','createdAt'])
        && request.resource.data.role in ['customer','business']
        && request.resource.data.name is string && request.resource.data.name.size() <= 60;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','name','phone','favorites'])
        && request.resource.data.role in ['customer','business']
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.favorites is list && request.resource.data.favorites.size() <= 50;
      allow delete: if isAdmin();

      // Historial del cliente: una copia de cada pedido que hizo con su cuenta.
      match /orders/{oid} {
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['rid','rname','num','total','items','cart','pay','createdAt'])
          && exists(/databases/$(database)/documents/restaurants/$(request.resource.data.rid)/orders/$(oid));
        allow delete: if signedIn() && request.auth.uid == uid;
        allow update: if false;
      }
    }

    // ---------- Negocios ----------
    // restaurants/{rid}: rid es el enlace del negocio (ej. "tortas-tortuga").
    match /restaurants/{rid} {
      allow get, list: if resource.data.status == 'active'
        || (signedIn() && resource.data.ownerUid == request.auth.uid)
        || isAdmin();
      // Cualquiera con cuenta puede registrar su negocio; queda "pending" hasta que el admin lo aprueba.
      allow create: if signedIn()
        && rid.matches('^[a-z0-9][a-z0-9-]{1,38}[a-z0-9]$')
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(profileKeys().concat(['ownerUid','status','createdAt']))
        && validProfile(request.resource.data);
      allow update: if (signedIn() && resource.data.ownerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(profileKeys())
          && validProfile(request.resource.data))
        || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['pending','active','suspended']);
      allow delete: if isAdmin();

      // Menú del negocio: todos lo leen, solo el dueño lo cambia.
      match /menu/{doc} {
        allow read: if true;
        allow write: if isOwnerOf(rid)
          && request.resource.data.keys().hasOnly(['items','extras','updatedAt'])
          && request.resource.data.items is list
          && request.resource.data.items.size() <= 100;
      }

      // Fotos de los platillos (plan gratuito): imágenes comprimidas, máximo ~300 KB cada una.
      match /photos/{pid} {
        allow read: if true;
        allow create, update: if isOwnerOf(rid)
          && request.resource.data.keys().hasOnly(['data','createdAt'])
          && request.resource.data.data is string
          && request.resource.data.data.size() < 300000;
        allow delete: if isOwnerOf(rid);
      }

      // Pedidos: el cliente crea el suyo (pago al recoger) y lo sigue por su número;
      // solo el dueño ve la lista y cambia el estado. Los pedidos con tarjeta los crea el servidor.
      match /orders/{oid} {
        allow get: if true;
        allow list: if isOwnerOf(rid) || isAdmin();
        allow create: if rest(rid).status == 'active'
          && !(('paused' in rest(rid)) && rest(rid).paused == true)
          && request.resource.data.keys().hasOnly(['num','who','items','total','status','pickup','createdAt','pay','uid','note'])
          && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 200))
          && (!('uid' in request.resource.data) || (signedIn() && request.resource.data.uid == request.auth.uid))
          && request.resource.data.status == 'new'
          && request.resource.data.pay == 'cash'
          && request.resource.data.who is string && request.resource.data.who.size() >= 1 && request.resource.data.who.size() <= 40
          && request.resource.data.items is list && request.resource.data.items.size() <= 30
          && request.resource.data.total is number && request.resource.data.total < 1000;
        allow update: if isOwnerOf(rid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['new','prep','ready','done'];
        allow delete: if isOwnerOf(rid);
      }
    }

    // ---------- Datos de la versión anterior (solo Tortas Tortuga) ----------
    // Se conservan para poder importarlos al nuevo formato. El admin los lee; nadie más los cambia.
    match /orders/{id} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if false;
    }
    match /settings/{doc} {
      allow read: if true;
      allow write: if false;
    }
  }
}
